{
  "name": "@openally/auto-url",
  "version": "2.0.0",
  "description": "Utility to build WHATWG URL from an object payload",
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run test-export",
    "test-only": "node --test ./test/**/*.spec.ts",
    "test-export": "npm run build && attw --pack . --profile esm-only",
    "test": "npm run test-export && c8 --all --src ./src -r html npm run test-only",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAlly/npm-packages.git",
    "directory": "src/auto-url"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "whatwg",
    "url",
    "utility"
  ],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT"
}
