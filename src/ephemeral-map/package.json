{
  "name": "@openally/ephemeral-map",
  "version": "3.0.0",
  "description": "ES6 Map-Like implementation with keys that have a defined timelife",
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run test-export",
    "test-only": "node --test ./test/**/*.spec.ts",
    "test-export": "npm run build && attw --pack . --profile esm-only",
    "test": "npm run test-export && c8 --all --src ./src -r html npm run test-only",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAlly/npm-packages.git",
    "directory": "src/ephemeral-map"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@openally/timestore": "^3.0.0",
    "type-fest": "5.8.0"
  }
}
