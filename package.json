{
  "name": "@openally/npm-packages",
  "version": "1.0.0",
  "description": "OpenAlly NPM packages",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck --ws --if-present",
    "test": "npm run test --ws --if-present",
    "lint": "eslint src",
    "ci:publish": "changeset publish",
    "ci:version": "changeset version",
    "clean": "clear-ts-build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAlly/npm-packages.git"
  },
  "keywords": [],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "workspaces": [
    "src/timestore",
    "src/ephemeral-map",
    "src/mutex",
    "src/result",
    "src/auto-url",
    "src/config",
    "src/event-loop-monitor",
    "src/emitt",
    "src/collector",
    "src/atomic-fs",
    "src/servo"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OpenAlly/npm-packages/issues"
  },
  "homepage": "https://github.com/OpenAlly/npm-packages#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@faker-js/faker": "10.6.0",
    "@openally/config.eslint": "3.0.2",
    "@openally/config.typescript": "1.3.0",
    "@types/node": "26.6.2",
    "c8": "^12.0.0",
    "iterator-matcher": "^2.1.0",
    "typescript": "5.9.3"
  }
}
